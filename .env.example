# Core Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<dbname>?ssl=require
SYNC_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# Security
SECRET_KEY=super-secret-key-change-in-production-2026

# AI / OpenAI API Key
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/v1/telegram/webhook

# Daily Automation (server-side worker - keeps running without your PC)
DAILY_DIGEST_ENABLED=true
# Local (course-timezone) hour when the "today's lessons" digest is sent
DAILY_DIGEST_HOUR=7
GOOGLE_CALENDAR_SYNC_ENABLED=true

# Google OAuth & Calendar API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth2callback

# Upload Storage
UPLOAD_DIR=./uploads

# Cloudflare R2 object storage (free: 10 GB storage + unlimited egress).
# Keeps big PDF bytes OUT of the database so the Neon transfer quota survives.
# Create R2 -> API Tokens -> "Manage R2 Tokens" -> token scoped to one bucket.
R2_ACCOUNT_ID=your-account-id-here
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name

# Frontend base URL (used for password-reset links sent via Telegram)
FRONTEND_URL=http://localhost:3000
